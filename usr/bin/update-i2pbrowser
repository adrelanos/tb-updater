# shellcheck source=../../../helper-scripts/usr/libexec/helper-scripts/check_runtime.bsh
source /usr/libexec/helper-scripts/check_runtime.bsh

if was_executed "${BASH_SOURCE[0]}"; then
   set -o errexit
   set -o nounset
   set -o errtrace
   set -o pipefail
fi

main() {
   SCRIPTNAME="$(basename -- "${BASH_SOURCE[0]}")"
   export SCRIPTNAME

   export ICON="/usr/share/icons/icon-pack-dist/tbupdate.ico"

   export IDENTIFIER="i2pbrowser-downloader"
   export tb_install_folder="i2pb"
   export tb_install_folder_dot=".i2pb"
   export tb_title="i2p Browser"
   export tb_wiki="i2p_Browser"
   export tb_browser_name="i2p-browser"
   export tb_settings_folder="i2pbrowser.d"
   export tb_bin="i2pbrowser"

   update-torbrowser "$@"
}

if was_executed "${BASH_SOURCE[0]}"; then
   main "$@"
fi
